{
  "manifest_version": 3,
  "name": "ContextAI",
  "version": "1.0.0",
  "description": "AI-powered browser assistant",

  "action": {
    "default_popup": "index.html",
    "default_title": "ContextAI"
  },

  "permissions": [
    "activeTab",
    "tabs",
    "scripting"
  ],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}